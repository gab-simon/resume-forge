# Copie para .env. Todas as configurações e padrões estão em app/infra/settings.py.

LOG_LEVEL=INFO

# Origens do front que podem chamar a API pelo browser, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL, sem o esquema da URI; a aplicação adiciona postgresql+psycopg://.
# DB_URL usa o papel restrito da aplicação (APP_DB_USER de infra/postgres/.env);
# DB_MIGRATION_URL usa o dono das tabelas (POSTGRES_USER).
DB_URL=resume_forge_app:troque-por-outra-senha-longa@localhost:9001/resume_forge
DB_URL_DOCKER=resume_forge_app:troque-por-outra-senha-longa@resume-forge-postgres:5432/resume_forge
DB_MIGRATION_URL=resume_forge:troque-por-uma-senha-longa@localhost:9001/resume_forge
DB_MIGRATION_URL_DOCKER=resume_forge:troque-por-uma-senha-longa@resume-forge-postgres:5432/resume_forge

# Login por código no e-mail. Gere o segredo com: openssl rand -hex 32
AUTH_OTP_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# console escreve o e-mail (com o código) no log da API: só para desenvolvimento.
# Em produção use smtp e preencha as variáveis SMTP_*.
EMAIL_BACKEND=console
EMAIL_FROM=Resume Forge <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Ferramentas externas (TeX Live e poppler-utils).
LATEX_COMMAND=pdflatex
PDFTOTEXT_COMMAND=pdftotext
